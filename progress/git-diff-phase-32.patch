+# LIKE 转义字符
+_LIKE_ESCAPE_CHAR = "\\"
+
+
+def escape_like(value: str) -> str:
+    """转义 LIKE 通配符 % _ 和转义符本身。"""
+    return (
+        value.replace("\\", "\\\\")
+        .replace("%", "\\%")
+        .replace("_", "\\_")
+    )
+
+
+def like_pattern(value: str) -> str:
+    """构建 LIKE 模式并转义。"""
+    return f"%{escape_like(value)}%"
+
+
+def like_clause(field: str) -> str:
+    """构建字段 LIKE 子句，带 ESCAPE。"""
+    return f"{field} LIKE ? ESCAPE '{_LIKE_ESCAPE_CHAR}'"
+
 
