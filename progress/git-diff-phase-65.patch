+                cfg = raw.get("logging", {}) if raw else {}
+            except Exception:
+                cfg = {}
+
+        log_dir = os.environ.get("PROJECT_MEMORY_LOG_DIR")
+        if not log_dir:
+            log_dir = cfg.get("log_dir")
