+
+def make_response(data: dict) -> dict:
+    return {"ok": True, "data": data}
+
+
+def make_error_response(code: str, message: str, details: dict | None = None) -> dict:
+    return {
+        "ok": False,
+        "error": {"code": code, "message": message, "details": details or {}},
+    }
